{
  "name": "systemd-toolkit",
  "displayName": "systemd Toolkit",
  "description": "Language support for systemd unit, network, and configuration files: syntax highlighting, directive completion, hover documentation, and systemctl integration.",
  "version": "0.1.0",
  "publisher": "kiozwang",
  "license": "LGPL-2.1-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/kioz-wang/systemd-toolkit.vscode.git"
  },
  "icon": "resources/systemd.png",
  "extensionKind": "workspace",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "systemd",
    "unit",
    "service",
    "networkd",
    "systemctl"
  ],
  "main": "./out/extension.js",
  "systemdSupportedVersions": {
    "min": "258",
    "max": "261",
    "note": "Directive data ships per-version (data/directives-v<N>.json). Keep in sync with data/manifest.json generated by scripts/generate-data.py."
  },
  "activationEvents": [
    "onLanguage:systemd",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "systemd",
        "aliases": [
          "systemd unit file",
          "systemd"
        ],
        "extensions": [
          ".service",
          ".socket",
          ".timer",
          ".path",
          ".mount",
          ".swap",
          ".automount",
          ".target",
          ".slice",
          ".scope",
          ".device",
          ".unit",
          ".network",
          ".netdev",
          ".link",
          ".nspawn",
          ".dnssd",
          ".dns-delegate"
        ],
        "filenames": [
          "system.conf",
          "user.conf",
          "journald.conf",
          "journal-remote.conf",
          "journal-upload.conf",
          "logind.conf",
          "resolved.conf",
          "timesyncd.conf",
          "coredump.conf",
          "homed.conf",
          "networkd.conf",
          "oomd.conf",
          "pstore.conf",
          "sleep.conf",
          "sysext.conf",
          "udev.conf",
          "iocost.conf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "systemd",
        "scopeName": "source.systemd",
        "path": "./syntaxes/systemd.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "systemd",
        "path": "./snippets/units.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "systemd",
          "title": "systemd",
          "icon": "resources/systemd.svg"
        }
      ]
    },
    "views": {
      "systemd": [
        {
          "id": "systemd.target",
          "name": "Target",
          "icon": "resources/systemd.svg",
          "contextualTitle": "systemd Target"
        },
        {
          "id": "systemd.units",
          "name": "Loaded",
          "icon": "resources/systemd.svg",
          "contextualTitle": "systemd Loaded Units"
        },
        {
          "id": "systemd.installed",
          "name": "Installed",
          "icon": "resources/systemd.svg",
          "contextualTitle": "systemd Installed (not loaded)",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "systemd",
      "properties": {
        "systemd.docSource": {
          "type": "string",
          "enum": [
            "online",
            "man"
          ],
          "default": "online",
          "description": "Where directive help is resolved from. 'online' opens the HTML man pages on freedesktop.org; 'man' opens local man pages in a terminal."
        },
        "systemd.onlineDocBase": {
          "type": "string",
          "default": "https://www.freedesktop.org/software/systemd/man/latest/",
          "description": "Base URL used when systemd.docSource is 'online'."
        },
        "systemd.systemctlPath": {
          "type": "string",
          "default": "systemctl",
          "description": "Path to the systemctl binary."
        },
        "systemd.journalctlPath": {
          "type": "string",
          "default": "journalctl",
          "description": "Path to the journalctl binary."
        },
        "systemd.runInTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Run systemctl/journalctl in an integrated terminal instead of an output channel."
        },
        "systemd.authMethod": {
          "type": "string",
          "enum": [
            "sudo",
            "pkexec",
            "none"
          ],
          "enumDescriptions": [
            "Prefix privileged commands with sudo and run them in a terminal (password prompt works).",
            "Prefix privileged commands with pkexec (polkit dialog).",
            "Run privileged commands without elevation."
          ],
          "default": "sudo",
          "description": "How to elevate privileges for management commands (start/stop/restart/reload/enable/disable/daemon-reload)."
        },
        "systemd.versionOverride": {
          "type": "string",
          "default": "",
          "description": "Force the directive data version (e.g. \"262\"). When empty, the local systemd version is detected automatically."
        },
        "systemd.host": {
          "type": "string",
          "default": "",
          "description": "SSH host (alias from ~/.ssh/config) to operate on. Empty means the local machine. Commands are run via `ssh <host> systemctl ...` when set."
        },
        "systemd.scope": {
          "type": "string",
          "enum": [
            "system",
            "user"
          ],
          "default": "system",
          "description": "Which systemd instance to manage: \"system\" (system units, default) or \"user\" (user units, via `systemctl --user`). User units deploy to ~/.config/systemd/user/ and never require elevation."
        },
        "systemd.sshPath": {
          "type": "string",
          "default": "ssh",
          "description": "Path to the ssh binary used when systemd.host is set."
        }
      }
    },
    "commands": [
      {
        "command": "systemd.status",
        "title": "Show Unit Status",
        "category": "systemd"
      },
      {
        "command": "systemd.start",
        "title": "Start Unit",
        "category": "systemd"
      },
      {
        "command": "systemd.stop",
        "title": "Stop Unit",
        "category": "systemd"
      },
      {
        "command": "systemd.restart",
        "title": "Restart Unit",
        "category": "systemd"
      },
      {
        "command": "systemd.reload",
        "title": "Reload Unit",
        "category": "systemd"
      },
      {
        "command": "systemd.enable",
        "title": "Enable Unit",
        "category": "systemd"
      },
      {
        "command": "systemd.disable",
        "title": "Disable Unit",
        "category": "systemd"
      },
      {
        "command": "systemd.daemonReload",
        "title": "Reload Daemon",
        "category": "systemd"
      },
      {
        "command": "systemd.logs",
        "title": "Show Unit Logs",
        "category": "systemd"
      },
      {
        "command": "systemd.units.refresh",
        "title": "Refresh",
        "category": "systemd",
        "icon": "$(refresh)"
      },
      {
        "command": "systemd.units.showList",
        "title": "Show as List",
        "category": "systemd",
        "icon": "$(list-flat)"
      },
      {
        "command": "systemd.units.showTree",
        "title": "Show as Tree",
        "category": "systemd",
        "icon": "$(list-tree)"
      },
      {
        "command": "systemd.units.hideInactive",
        "title": "Hide Inactive Units",
        "category": "systemd",
        "icon": "$(eye)"
      },
      {
        "command": "systemd.units.showInactive",
        "title": "Show Inactive Units",
        "category": "systemd",
        "icon": "$(eye-closed)"
      },
      {
        "command": "systemd.units.filter",
        "title": "Filter Units",
        "category": "systemd",
        "icon": "$(filter)"
      },
      {
        "command": "systemd.units.clearFilter",
        "title": "Clear Unit Filter",
        "category": "systemd",
        "icon": "$(clear-all)"
      },
      {
        "command": "systemd.installed.showList",
        "title": "Show as List",
        "category": "systemd",
        "icon": "$(list-flat)"
      },
      {
        "command": "systemd.installed.showTree",
        "title": "Show as Tree",
        "category": "systemd",
        "icon": "$(list-tree)"
      },
      {
        "command": "systemd.installed.filter",
        "title": "Filter Installed Units",
        "category": "systemd",
        "icon": "$(filter)"
      },
      {
        "command": "systemd.installed.clearFilter",
        "title": "Clear Installed Filter",
        "category": "systemd",
        "icon": "$(clear-all)"
      },
      {
        "command": "systemd.switchHost",
        "title": "Switch Host",
        "category": "systemd",
        "icon": "$(remote)"
      },
      {
        "command": "systemd.switchScope",
        "title": "Switch Unit Scope",
        "category": "systemd",
        "icon": "$(symbol-property)"
      },
      {
        "command": "systemd.units.status",
        "title": "Show Unit Status",
        "category": "systemd"
      },
      {
        "command": "systemd.units.start",
        "title": "Start Unit",
        "category": "systemd",
        "icon": "$(play)"
      },
      {
        "command": "systemd.units.stop",
        "title": "Stop Unit",
        "category": "systemd",
        "icon": "$(debug-stop)"
      },
      {
        "command": "systemd.units.restart",
        "title": "Restart Unit",
        "category": "systemd",
        "icon": "$(debug-restart)"
      },
      {
        "command": "systemd.units.enable",
        "title": "Enable Unit",
        "category": "systemd"
      },
      {
        "command": "systemd.units.disable",
        "title": "Disable Unit",
        "category": "systemd"
      },
      {
        "command": "systemd.units.logs",
        "title": "Show Unit Logs",
        "category": "systemd",
        "icon": "$(output)"
      },
      {
        "command": "systemd.units.viewFile",
        "title": "View Unit File",
        "category": "systemd"
      },
      {
        "command": "systemd.units.editFile",
        "title": "Edit Unit File",
        "category": "systemd"
      },
      {
        "command": "systemd.units.newUnit",
        "title": "New Unit",
        "category": "systemd",
        "icon": "$(new-file)"
      },
      {
        "command": "systemd.deploy",
        "title": "Deploy Unit File",
        "category": "systemd"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "systemd.units.refresh",
          "when": "view == systemd.target",
          "group": "navigation@1"
        },
        {
          "command": "systemd.units.showTree",
          "when": "view == systemd.units && !systemd.units.treeMode",
          "group": "navigation@2"
        },
        {
          "command": "systemd.units.showList",
          "when": "view == systemd.units && systemd.units.treeMode",
          "group": "navigation@2"
        },
        {
          "command": "systemd.units.hideInactive",
          "when": "view == systemd.units && systemd.units.showInactive",
          "group": "navigation@3"
        },
        {
          "command": "systemd.units.showInactive",
          "when": "view == systemd.units && !systemd.units.showInactive",
          "group": "navigation@3"
        },
        {
          "command": "systemd.units.filter",
          "when": "view == systemd.units && !systemd.units.hasFilter",
          "group": "navigation@4"
        },
        {
          "command": "systemd.units.clearFilter",
          "when": "view == systemd.units && systemd.units.hasFilter",
          "group": "navigation@4"
        },
        {
          "command": "systemd.installed.showTree",
          "when": "view == systemd.installed && !systemd.installed.treeMode",
          "group": "navigation@1"
        },
        {
          "command": "systemd.installed.showList",
          "when": "view == systemd.installed && systemd.installed.treeMode",
          "group": "navigation@1"
        },
        {
          "command": "systemd.installed.filter",
          "when": "view == systemd.installed && !systemd.installed.hasFilter",
          "group": "navigation@2"
        },
        {
          "command": "systemd.installed.clearFilter",
          "when": "view == systemd.installed && systemd.installed.hasFilter",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "systemd.units.newUnit",
          "when": "viewItem == type-group",
          "group": "inline@1"
        },
        {
          "command": "systemd.units.logs",
          "when": "viewItem =~ /^unit:/",
          "group": "inline@1"
        },
        {
          "command": "systemd.units.start",
          "when": "viewItem =~ /^unit:inactive/",
          "group": "inline@2"
        },
        {
          "command": "systemd.units.stop",
          "when": "viewItem =~ /^unit:active/",
          "group": "inline@2"
        },
        {
          "command": "systemd.units.restart",
          "when": "viewItem =~ /^unit:(active|failed)/",
          "group": "inline@3"
        },
        {
          "command": "systemd.units.status",
          "when": "viewItem =~ /^unit:/",
          "group": "systemd@1"
        },
        {
          "command": "systemd.units.start",
          "when": "viewItem =~ /^unit:inactive/",
          "group": "systemd@2"
        },
        {
          "command": "systemd.units.stop",
          "when": "viewItem =~ /^unit:active/",
          "group": "systemd@2"
        },
        {
          "command": "systemd.units.restart",
          "when": "viewItem =~ /^unit:(active|failed)/",
          "group": "systemd@2"
        },
        {
          "command": "systemd.units.enable",
          "when": "viewItem =~ /:disabled$/",
          "group": "systemd@3"
        },
        {
          "command": "systemd.units.disable",
          "when": "viewItem =~ /:enabled$/",
          "group": "systemd@3"
        },
        {
          "command": "systemd.units.logs",
          "when": "viewItem =~ /^unit:/",
          "group": "systemd@4"
        },
        {
          "command": "systemd.units.viewFile",
          "when": "viewItem =~ /^unit:/",
          "group": "systemd@5"
        },
        {
          "command": "systemd.units.editFile",
          "when": "viewItem =~ /^unit:/",
          "group": "systemd@5"
        }
      ],
      "editor/title": [
        {
          "command": "systemd.restart",
          "when": "resourceLangId == systemd && resourceFilename =~ /\\.(service|socket|timer|path|mount|swap|automount|target|slice|scope)$/",
          "group": "systemd@1"
        },
        {
          "command": "systemd.status",
          "when": "resourceLangId == systemd && resourceFilename =~ /\\.(service|socket|timer|path|mount|swap|automount|target|slice|scope)$/",
          "group": "systemd@2"
        },
        {
          "command": "systemd.logs",
          "when": "resourceLangId == systemd && resourceFilename =~ /\\.(service|socket|timer|path|mount|swap|automount|target|slice|scope)$/",
          "group": "systemd@3"
        },
        {
          "command": "systemd.deploy",
          "when": "resourceLangId == systemd && resourceFilename =~ /\\.(service|socket|timer|path|mount|swap|automount|target|slice|scope)$/",
          "group": "systemd@4"
        }
      ],
      "commandPalette": [
        { "command": "systemd.units.status", "when": "false" },
        { "command": "systemd.units.start", "when": "false" },
        { "command": "systemd.units.stop", "when": "false" },
        { "command": "systemd.units.restart", "when": "false" },
        { "command": "systemd.units.enable", "when": "false" },
        { "command": "systemd.units.disable", "when": "false" },
        { "command": "systemd.units.logs", "when": "false" },
        { "command": "systemd.units.viewFile", "when": "false" },
        { "command": "systemd.units.editFile", "when": "false" },
        { "command": "systemd.units.newUnit", "when": "false" },
        { "command": "systemd.units.refresh", "when": "false" },
        { "command": "systemd.units.showList", "when": "false" },
        { "command": "systemd.units.showTree", "when": "false" },
        { "command": "systemd.units.hideInactive", "when": "false" },
        { "command": "systemd.units.showInactive", "when": "false" },
        { "command": "systemd.units.filter", "when": "false" },
        { "command": "systemd.units.clearFilter", "when": "false" },
        { "command": "systemd.installed.showList", "when": "false" },
        { "command": "systemd.installed.showTree", "when": "false" },
        { "command": "systemd.installed.filter", "when": "false" },
        { "command": "systemd.installed.clearFilter", "when": "false" },
        { "command": "systemd.switchHost", "when": "false" },
        { "command": "systemd.switchScope", "when": "false" }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "generate": "python3 scripts/generate-data.py",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}
